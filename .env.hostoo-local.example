# =============================================================================
# Arcana Tarot — perfil "modo Hostoo" para teste local
# =============================================================================
# Reproduz o ambiente de hospedagem compartilhada SEM Redis, SEM Reverb e SEM
# worker permanente: cache, sessão e fila no MySQL; tempo real por polling.
# O `.env` do Docker/Reverb não é alterado — o perfil vive em um arquivo à parte
# e é carregado com `--env=hostoo-local`.
#
#   cp .env.hostoo-local.example .env.hostoo-local
#   php artisan key:generate --env=hostoo-local
#   php artisan migrate --force --env=hostoo-local
#   php artisan serve --env=hostoo-local
# Se o PHP do host não tiver pdo_mysql/gd/intl/bcmath, prefixe cada comando com
# `docker compose run --rm --no-deps app` (seção 2.1 do guia).
#
# Guia completo, emulação do cron e checklist de fumaça:
# docs/TESTE_LOCAL_MODO_HOSTOO.md
# =============================================================================

APP_NAME="Arcana Tarot"
# O nome do ambiente tem de casar com o sufixo deste arquivo. `--env=hostoo-local`
# carrega `.env.hostoo-local`, e o servidor embutido repassa `APP_ENV` ao processo
# filho: qualquer outro valor faz o `artisan serve` cair no `.env` do Docker (e no
# banco de desenvolvimento). Para herdar os guardas de produção, crie um
# `.env.production` com `APP_ENV=production` (§7.2 do guia).
APP_ENV=hostoo-local
# O seeder de demonstração é bloqueado com APP_ENV=production; mantenha vazio.
ARCANA_DEMO_PASSWORD=
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Banco de dados ----------------------------------------------------------
# Banco separado para o teste não contaminar os dados de desenvolvimento
# (`arcana_tarot`). Crie uma vez com:
#   docker compose exec -T mysql mysql -uroot -parcana_root_secret \
#     -e "CREATE DATABASE IF NOT EXISTS arcana_hostoo CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
#
# `DB_HOST=mysql` vale para o PHP rodando no container `app` (rede do Compose).
# Para rodar com o PHP do host, troque para `127.0.0.1` (porta 3306 publicada).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=arcana_hostoo
DB_USERNAME=arcana
DB_PASSWORD=arcana_secret

# --- Sessão, cache e fila sem Redis ------------------------------------------
# `database` usa as tabelas `sessions`, `cache` e `jobs` já criadas pelas
# migrations padrão. A fila só anda porque o cron chama `queue:work`.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Em produção (`https`) isto é `true`. Localmente é `false`, senão o navegador
# nunca envia o cookie de sessão em http:// e o login "não persiste".
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SESSION_PATH=/

CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Tempo real sem WebSocket ------------------------------------------------
# `log` mantém os eventos `ShouldBroadcast` funcionando sem serviço externo
# (nada é enviado a navegador algum). Com CONSULTATION_WEBSOCKET_ENABLED=false o
# servidor publica `data-realtime-mode="poll"` e as telas leem os endpoints de
# recuperação. Não configure REVERB_*/VITE_REVERB_* aqui.
BROADCAST_CONNECTION=log
CONSULTATION_WEBSOCKET_ENABLED=false

# Intervalos de leitura. O chat lê a cada 2 s e o painel a cada 3 s; com a aba
# oculta os intervalos sobem para poupar CPU/FPM. O backoff máximo limita a
# espera após falhas consecutivas.
CONSULTATION_POLL_CHAT_MS=2000
CONSULTATION_POLL_CHAT_HIDDEN_MS=10000
CONSULTATION_POLL_PANEL_MS=3000
CONSULTATION_POLL_PANEL_HIDDEN_MS=15000
CONSULTATION_POLL_MAX_BACKOFF_MS=30000

# Teto de leituras por participante/minuto. O chat a 2 s consome 30/min; os
# valores abaixo deixam folga para recargas e reconexões.
CONSULTATION_MESSAGE_FEED_RATE_PER_MINUTE=90
CONSULTATION_PANEL_FEED_RATE_PER_MINUTE=60

# -----------------------------------------------------------------------------
# TRUSTED_PROXIES: não configure aqui.
# `bootstrap/app.php` resolve o valor com `env()` antes do bootstrap do Dotenv e,
# com `config:cache`, o `.env` nem chega a ser lido — neste arquivo a chave seria
# silenciosamente ignorada. No Hostoo o valor precisa vir do servidor
# (`SetEnv` no `.htaccess` ou variável de ambiente do PHP). Ver §6 de
# docs/TESTE_LOCAL_MODO_HOSTOO.md.
# -----------------------------------------------------------------------------

# --- Arquivos ---------------------------------------------------------------
FILESYSTEM_DISK=local
# Teto por imagem do painel (cartas, fotos, logo, favicon e seções). O servidor
# normaliza orientação/dimensões e recomprime em WebP antes de gravar.
IMAGE_UPLOAD_MAX_KB=25600
IMAGE_MAX_PIXELS=40000000
IMAGE_DRIVER=gd
IMAGE_MEMORY_LIMIT=512M
ATTENDANT_SOUND_MAX_KB=1024

# --- Pagamentos -------------------------------------------------------------
# No Hostoo o provedor é `infinitepay`. Localmente o sandbox permite exercitar a
# carteira (recarga, webhook HMAC, créditos) sem credenciais e sem URL pública:
#   php artisan pix:sandbox-simulate {payment} approved --env=hostoo-local
# Troque para `infinitepay` ao validar o contrato real do checkout.
PAYMENT_PROVIDER=pix_sandbox
PAYMENT_SANDBOX_ENABLED=true
PAYMENT_SANDBOX_WEBHOOK_SECRET=
PAYMENT_SANDBOX_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENT_SANDBOX_CHARGE_TTL_MINUTES=30
PAYMENT_MIN_AMOUNT_CENTS=100
PAYMENT_MAX_AMOUNT_CENTS=1000000

INFINITEPAY_HANDLE=
INFINITEPAY_API_KEY=
INFINITEPAY_BASE_URL=https://api.checkout.infinitepay.io
INFINITEPAY_WEBHOOK_URL=
INFINITEPAY_CHARGE_TTL_MINUTES=1440
INFINITEPAY_TIMEOUT_SECONDS=15

# --- Cadastro por e-mail ----------------------------------------------------
# Domínios aceitos no formulário (lista separada por vírgula, sem "@"). Este
# perfil usa o mailpit do Docker: o link de confirmação cai em :8025 e vale por
# EMAIL_VERIFICATION_EXPIRE_MINUTES minutos.
REGISTRATION_ALLOWED_EMAIL_DOMAINS=gmail.com,hotmail.com,outlook.com,ig.com.br
EMAIL_VERIFICATION_EXPIRE_MINUTES=60

# --- Consultas --------------------------------------------------------------
CONSULTATION_REQUEST_TTL_MINUTES=10
CONSULTATION_PRESENCE_TIMEOUT_MINUTES=15
CONSULTATION_MESSAGE_MAX_LENGTH=2000
CONSULTATION_MESSAGE_PAGE_SIZE=25
CONSULTATION_MESSAGE_RATE_PER_MINUTE=30
CONSULTATION_CARD_RATE_PER_MINUTE=15

# Presença, inatividade e avisos (ver docs/SEGURANCA_E_USABILIDADE_CHAT.md).
CONSULTATION_MINIMUM_BALANCE_MINUTES=1
CONSULTATION_LAST_SEEN_TOUCH_SECONDS=30
CONSULTATION_INACTIVITY_TIMEOUT_MINUTES=5
CONSULTATION_RECONNECTION_TOLERANCE_SECONDS=90
CONSULTATION_ACTIVITY_PING_SECONDS=20
CONSULTATION_NAVIGATION_WARNING_SECONDS=60

CONSULTATION_AUDIO_ENABLED=true
CONSULTATION_VIDEO_ENABLED=true
# Sem TURN próprio, redes simétricas (4G/corporativo) derrubam a chamada. O
# sinal de WebRTC também passa por polling (`CONSULTATION_CALL_SIGNAL_POLL_MS`).
CONSULTATION_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'
CONSULTATION_CALL_RING_TIMEOUT_SECONDS=90
CONSULTATION_CALL_SIGNAL_POLL_MS=2500
CONSULTATION_CALL_SIGNAL_MAX_BYTES=65536
CONSULTATION_CALL_SIGNAL_MAX_PER_CALL=400

# --- E-mail -----------------------------------------------------------------
# No Hostoo é `smtp` (Brevo). Localmente, se não quiser enviar e-mail real, use
# MAIL_MAILER=log: o conteúdo cai em storage/logs/laravel.log.
# O Laravel 13 lê MAIL_SCHEME, não MAIL_ENCRYPTION: na porta 587 o STARTTLS é
# automático; para TLS implícito use MAIL_PORT=465 e MAIL_SCHEME=smtps.
# Teste do transporte: php artisan arcana:send-test-email seu-email@exemplo.com
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=c263d2001@smtp-brevo.com
MAIL_PASSWORD=colar_aqui_a_chave_smtp_gerada
MAIL_FROM_ADDRESS="seu-email-verificado@seudominio.com"
# O nome exibido nos e-mails acompanha o campo "Nome do site" de
# /admin/conteudo (settings.site_name), então trocar a identidade no painel não
# exige mexer no .env. MAIL_FROM_NAME é apenas o fallback usado enquanto a
# identidade não existir no banco (ou se o banco estiver indisponível).
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
