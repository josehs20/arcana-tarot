APP_NAME="Arcana Tarot"
APP_ENV=local
# Senha exclusiva dos usuários fictícios criados por `php artisan db:seed`.
# Nunca reutilize este valor em produção; o seeder é bloqueado com APP_ENV=production.
ARCANA_DEMO_PASSWORD="ArcanaDemo!2026"
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Produção: APP_ENV=production, APP_DEBUG=false, APP_URL=https://... e LOG_LEVEL=warning.

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=arcana_tarot
DB_USERNAME=arcana
DB_PASSWORD=arcana_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Em produção com HTTPS, use SESSION_SECURE_COOKIE=true e SESSION_ENCRYPT=true.
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=reverb
# Transporte em tempo real: com broadcaster WebSocket (reverb/pusher/ably) as
# telas usam canais; sem ele (log/null), passam a fazer polling HTTP. Guia:
# docs/ARQUITETURA_PRODUCAO_HOSTOO.md
CONSULTATION_WEBSOCKET_ENABLED=true
CONSULTATION_POLL_CHAT_MS=2000
CONSULTATION_POLL_CHAT_HIDDEN_MS=10000
CONSULTATION_POLL_PANEL_MS=3000
CONSULTATION_POLL_PANEL_HIDDEN_MS=15000
CONSULTATION_POLL_MAX_BACKOFF_MS=30000
CONSULTATION_MESSAGE_FEED_RATE_PER_MINUTE=90
CONSULTATION_PANEL_FEED_RATE_PER_MINUTE=60
# Proxies confiáveis para X-Forwarded-* (deixe vazio em Docker; `*` no Hostoo).
TRUSTED_PROXIES=
FILESYSTEM_DISK=local
TAROT_IMAGE_MAX_KB=5120
ATTENDANT_SOUND_MAX_KB=1024


PAYMENT_PROVIDER=infinitepay
INFINITEPAY_HANDLE=$jose-henrique-simiquel-s
INFINITEPAY_API_KEY=
INFINITEPAY_BASE_URL=https://api.checkout.infinitepay.io
INFINITEPAY_WEBHOOK_URL=
INFINITEPAY_CHARGE_TTL_MINUTES=1440
INFINITEPAY_TIMEOUT_SECONDS=15
PAYMENT_MIN_AMOUNT_CENTS=100
PAYMENT_MAX_AMOUNT_CENTS=1000000

# --- Login com Google (Socialite) -------------------------------------------
# O botão "Continuar com Google" só aparece com as duas credenciais abaixo.
# Redirect autorizado no Google Cloud: {APP_URL}/auth/google/callback
GOOGLE_LOGIN_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Cadastro por e-mail ----------------------------------------------------
# Domínios aceitos no formulário de cadastro (lista separada por vírgula, sem
# "@"). O POST cria a conta na hora e libera o painel somente depois que o link
# enviado por e-mail (MAIL_* acima) é confirmado; o link vale por
# EMAIL_VERIFICATION_EXPIRE_MINUTES minutos.
REGISTRATION_ALLOWED_EMAIL_DOMAINS=gmail.com,hotmail.com,outlook.com,ig.com.br
EMAIL_VERIFICATION_EXPIRE_MINUTES=60

# --- Bônus de primeiro acesso ----------------------------------------------
# Valores de instalação; depois que a administração salva em
# /admin/financeiro/bonus a configuração gravada em `settings` prevalece.
FIRST_ACCESS_BONUS_ENABLED=false
FIRST_ACCESS_BONUS_CREDITS=0

# InfinitePay Checkout Integrado (use PAYMENT_PROVIDER=infinitepay para ativar)


CONSULTATION_REQUEST_TTL_MINUTES=10
CONSULTATION_PRESENCE_TIMEOUT_MINUTES=15
# Aviso de saldo baixo na tela de atendimento (somente para o cliente).
CONSULTATION_LOW_BALANCE_WARNING_MINUTES=5
CONSULTATION_MESSAGE_MAX_LENGTH=2000
CONSULTATION_MESSAGE_PAGE_SIZE=25
CONSULTATION_MESSAGE_RATE_PER_MINUTE=30
CONSULTATION_CARD_RATE_PER_MINUTE=15
# Mensagens de voz no atendimento por audio (gravadas no navegador).
CONSULTATION_VOICE_MAX_KB=4096
CONSULTATION_VOICE_MAX_SECONDS=120
CONSULTATION_VOICE_RATE_PER_MINUTE=15

# Modalidades de audio e video (WebRTC). Desligue se a infraestrutura de
# midia nao estiver pronta; o servidor recusa a solicitacao nesse caso.
CONSULTATION_AUDIO_ENABLED=true
CONSULTATION_VIDEO_ENABLED=true
# JSON com servidores ICE. Inclua um TURN proprio em producao para redes
# simetricas; o STUN publico resolve apenas NAT simples.
CONSULTATION_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'
CONSULTATION_CALL_RING_TIMEOUT_SECONDS=90
CONSULTATION_CALL_SIGNAL_POLL_MS=2500
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel Reverb — servidor WebSocket privado.
# Gere o segredo local com: openssl rand -hex 32
REVERB_APP_ID=arcana
REVERB_APP_KEY=arcana_reverb_key
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Origens autorizadas a abrir o WebSocket. O Reverb compara apenas o host da
# origem, então `http://localhost:8000` e `localhost` produzem o mesmo efeito
# (a normalização fica em config/reverb.php). Use vírgula para listar várias.
REVERB_ALLOWED_ORIGINS="${APP_URL},127.0.0.1"
REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=30
REVERB_SCALING_ENABLED=false

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# --- E-mail -----------------------------------------------------------------
# Brevo (relay SMTP). Gere a chave em Brevo → SMTP & API → SMTP keys: a chave da
# API v3 não funciona no SMTP. O remetente precisa estar verificado no Brevo; o
# ideal é autenticar o domínio (DKIM/SPF) em vez de enviar por um Gmail.
# O Laravel 13 lê MAIL_SCHEME, não MAIL_ENCRYPTION: na porta 587 o STARTTLS é
# automático; para TLS implícito use MAIL_PORT=465 e MAIL_SCHEME=smtps.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=c263d2001@smtp-brevo.com
MAIL_PASSWORD=colar_aqui_a_chave_smtp_gerada
MAIL_FROM_ADDRESS="seu-email-verificado@seudominio.com"
# O nome exibido nos e-mails acompanha o campo "Nome do site" de
# /admin/conteudo (settings.site_name), então trocar a identidade no painel não
# exige mexer no .env. MAIL_FROM_NAME é apenas o fallback usado enquanto a
# identidade não existir no banco (ou se o banco estiver indisponível).
MAIL_FROM_NAME="${APP_NAME}"

# Teste rápido do transporte configurado acima (envio real e síncrono):
#   php artisan arcana:send-test-email seu-email@exemplo.com
#
# O worker da fila lê o .env só quando sobe: depois de mexer nestas variáveis,
# reinicie-o, senão os disparos de /admin/emails continuam saindo pelo
# transporte antigo (e ainda aparecem como "enviados" na tela).
#   docker compose exec app php artisan queue:restart
#
# Mailpit, para ver o HTML sem gastar cota do provedor (opcional):
#   docker compose --profile mailpit up -d mailpit
# e troque o bloco acima por MAIL_MAILER=smtp, MAIL_HOST=mailpit,
# MAIL_PORT=1025, MAIL_USERNAME=null, MAIL_PASSWORD=null. Painel: :8025

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
