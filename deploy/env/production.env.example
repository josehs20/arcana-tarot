# =============================================================================
# `.env` de PRODUÇÃO — VPS de 2 GB com duas instâncias (astros21 e voz-arcana)
# =============================================================================
# Na pasta da instância (ex.: /srv/astros21):
#   cp deploy/env/production.env.example .env
#   php artisan key:generate            (gera APP_KEY; ou use `openssl rand -base64 32`)
#   nano .env                           (troque tudo que está entre <>)
#
# Este arquivo é lido por DOIS consumidores:
#   1. o Laravel dentro dos containers (montado em /var/www/html/.env);
#   2. o docker compose, por interpolação de ${...} (APP_SLUG, APP_IMAGE e os
#      build args do Vite) — por isso as variáveis duplicadas abaixo existem.
#
# Depois de alterar qualquer valor: `docker compose -f docker-compose.prod.yml
# up -d --force-recreate` (o container mantém o arquivo antigo até ser recriado).
# =============================================================================

# --- Identidade no Compose e no proxy ---------------------------------------
# APP_SLUG define os nomes dos containers: `<slug>-web`, `<slug>-queue`,
# `<slug>-reverb`. O proxy em deploy/nginx/conf.d/ procura exatamente
# `astros21-web`/`astros21-reverb` ou `voz-arcana-web`/`voz-arcana-reverb`.
APP_SLUG=astros21
# Uma imagem por instância: as VITE_* abaixo são embutidas no bundle pelo Vite.
APP_IMAGE=arcana-tarot/app:astros21

APP_NAME="<Nome do site>"
APP_ENV=production
# O seeder de demonstração é bloqueado com APP_ENV=production: mantenha vazio.
ARCANA_DEMO_PASSWORD=
APP_KEY=
APP_DEBUG=false
APP_URL=https://<dominio-da-instancia>

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# `daily` rotaciona e descarta após `LOG_DAILY_DAYS` (padrão 14): com `single`
# um erro em laço enche o disco do VPS. Leia com `docker compose logs -f web`.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Banco compartilhado (deploy/docker-compose.infra.yml) -------------------
# Host = nome do container na rede `shared-net`. Cada instância tem o seu banco
# e o seu usuário (criados por deploy/mysql/init/01-create-databases.sh); as
# credenciais ficam em deploy/.env no servidor.
DB_CONNECTION=mysql
DB_HOST=shared-mysql
DB_PORT=3306
DB_DATABASE=astros21_db
DB_USERNAME=astros21
DB_PASSWORD=<senha-do-banco-definida-em-deploy/.env>

# --- Sessão (no MySQL, não no Redis) ----------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Tempo real -------------------------------------------------------------
BROADCAST_CONNECTION=reverb
CONSULTATION_WEBSOCKET_ENABLED=true
CONSULTATION_POLL_CHAT_MS=2000
CONSULTATION_POLL_CHAT_HIDDEN_MS=10000
CONSULTATION_POLL_PANEL_MS=3000
CONSULTATION_POLL_PANEL_HIDDEN_MS=15000
CONSULTATION_POLL_MAX_BACKOFF_MS=30000
CONSULTATION_MESSAGE_FEED_RATE_PER_MINUTE=90
CONSULTATION_PANEL_FEED_RATE_PER_MINUTE=60

# Vazio de propósito: o nginx interno (docker/nginx/default.prod.conf) aplica
# `real_ip` e repassa `HTTPS` a partir do X-Forwarded-Proto do proxy, então o
# Laravel já enxerga o IP do visitante e o esquema https sem confiar em nada.
TRUSTED_PROXIES=

# --- Arquivos e imagens -----------------------------------------------------
FILESYSTEM_DISK=local
IMAGE_UPLOAD_MAX_KB=25600
# 10 MP (ex.: 3888x2592). A conta do ImageNormalizer é `largura*altura*12`
# bytes (três decodificações); com IMAGE_MEMORY_LIMIT=160M e ~35 MB de base
# sobram ~125 MB para a imagem — ~10,4 MP. Valores maiores estouram o limite
# de 220 MB do container `web` e o kernel mata o processo sem log do PHP.
IMAGE_MAX_PIXELS=10000000
IMAGE_DRIVER=gd
IMAGE_MEMORY_LIMIT=160M
ATTENDANT_SOUND_MAX_KB=1024

# --- Pagamentos -------------------------------------------------------------
PAYMENT_PROVIDER=infinitepay
INFINITEPAY_HANDLE=<handle-da-conta>
INFINITEPAY_API_KEY=
INFINITEPAY_BASE_URL=https://api.checkout.infinitepay.io
INFINITEPAY_WEBHOOK_URL=
INFINITEPAY_CHARGE_TTL_MINUTES=1440
INFINITEPAY_TIMEOUT_SECONDS=15
PAYMENT_MIN_AMOUNT_CENTS=100
PAYMENT_MAX_AMOUNT_CENTS=1000000

# --- Login com Google (Socialite) -------------------------------------------
# Redirect autorizado no Google Cloud: {APP_URL}/auth/google/callback
GOOGLE_LOGIN_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_MOBILE_CLIENT_IDS=

# --- Cadastro por e-mail ----------------------------------------------------
REGISTRATION_ALLOWED_EMAIL_DOMAINS=gmail.com,hotmail.com,outlook.com,ig.com.br
EMAIL_VERIFICATION_EXPIRE_MINUTES=60

# --- Bônus de primeiro acesso ----------------------------------------------
# Depois que a administração salva em /admin/financeiro/bonus, o valor em
# `settings` prevalece sobre estas duas variáveis.
FIRST_ACCESS_BONUS_ENABLED=false
FIRST_ACCESS_BONUS_CREDITS=0

# --- Atendimento ------------------------------------------------------------
CONSULTATION_REQUEST_TTL_MINUTES=10
CONSULTATION_PRESENCE_TIMEOUT_MINUTES=15
CONSULTATION_LOW_BALANCE_WARNING_MINUTES=5
CONSULTATION_MESSAGE_MAX_LENGTH=2000
CONSULTATION_MESSAGE_PAGE_SIZE=25
CONSULTATION_MESSAGE_RATE_PER_MINUTE=30
CONSULTATION_CARD_RATE_PER_MINUTE=15
CONSULTATION_VOICE_MAX_KB=4096
CONSULTATION_VOICE_MAX_SECONDS=120
CONSULTATION_VOICE_RATE_PER_MINUTE=15

# Áudio/vídeo (WebRTC). A mídia NÃO passa pelo VPS: só a sinalização via Reverb.
# Em produção informe um TURN próprio (coturn em outro host ou serviço gerenciado)
# além do STUN; sem TURN, clientes atrás de NAT simétrico (4G) não conectam.
CONSULTATION_AUDIO_ENABLED=true
CONSULTATION_VIDEO_ENABLED=true
CONSULTATION_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'
CONSULTATION_CALL_RING_TIMEOUT_SECONDS=90
CONSULTATION_CALL_SIGNAL_POLL_MS=2500

# --- Fila e cache (Redis compartilhado) -------------------------------------
# Um único Redis (shared-redis) serve as duas instâncias. Isto evita que uma
# leia a fila/cache da outra:
#   banco 0 e 1 -> filas e pub/sub do Reverb   (astros21 / voz-arcana)
#   banco 2 e 3 -> cache                        (astros21 / voz-arcana)
#   REDIS_PREFIX/CACHE_PREFIX -> prefixo das chaves dentro do banco
# A segunda instância (voz-arcana) usa: REDIS_DB=1, REDIS_CACHE_DB=3,
# REDIS_PREFIX=voz-arcana_ e CACHE_PREFIX=voz-arcana_cache_.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=astros21_cache_
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=shared-redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=2
REDIS_PREFIX=astros21_

# --- Laravel Reverb ---------------------------------------------------------
# O navegador NÃO fala com este container diretamente: o proxy encaminha
# https://<dominio>/app/* para `<slug>-reverb:8080` (o caminho do WebSocket é o
# padrão do Echo, então não há nada a configurar no front).
# Gere o segredo com: openssl rand -hex 32
REVERB_APP_ID=astros21
REVERB_APP_KEY=<openssl rand -hex 16>
REVERB_APP_SECRET=<openssl rand -hex 32>
REVERB_HOST=astros21-reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS="${APP_URL}"
REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=30
# Instância única de Reverb: sem escala horizontal.
REVERB_SCALING_ENABLED=false

# Valores PÚBLICOS (vão para o bundle). Também são build args da imagem:
# mudar REVERB_APP_KEY ou o domínio exige rebuild
# (`docker compose -f docker-compose.prod.yml build web`).
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=<dominio-da-instancia>
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# --- E-mail -----------------------------------------------------------------
# O remetente precisa estar verificado no provedor (ideal: DKIM/SPF do domínio).
# Na porta 587 o STARTTLS é automático; TLS implícito é MAIL_PORT=465 +
# MAIL_SCHEME=smtps.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=<login-smtp-gerado-no-painel>
MAIL_PASSWORD=<chave-smtp-gerada-no-painel>
MAIL_FROM_ADDRESS="<email-verificado@seudominio.com>"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- API móvel (Sanctum) ----------------------------------------------------
SANCTUM_TOKEN_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=
API_RATE_LIMIT_PER_MINUTE=60
API_AUTH_RATE_LIMIT_PER_MINUTE=10
