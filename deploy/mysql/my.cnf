[mysqld]
# =============================================================================
# MariaDB 10.11 — ajuste para 350 MB de limite de memória (container)
# =============================================================================
# Dois bancos pequenos (astros21_db e voz_arcana_db) atendendo, no máximo,
# 2 aplicações x (5 workers PHP-FPM + worker de fila + agendador) ~ 20 conexões.
# Todos os valores abaixo são tetos: a memória só é alocada sob demanda.
# Conferir depois de subir:
#   docker exec shared-mysql mysql -uroot -p -e "SHOW VARIABLES LIKE 'innodb_buffer_pool_size'"
# =============================================================================

# --- InnoDB (o maior consumidor) ---------------------------------------------
innodb_buffer_pool_size = 128M
innodb_buffer_pool_instances = 1
innodb_log_buffer_size = 8M
innodb_io_capacity = 200
innodb_io_capacity_max = 400
# NÃO mexer em innodb_flush_log_at_trx_commit: o padrão (1) é o único aceitável
# para o ledger financeiro (wallet/ledger). Trocar por 2 ganharia desempenho e
# perderia até 1s de transações confirmadas em queda de energia.

# --- Motores MyISAM/Aria: o padrão do MariaDB reserva 128M em cada um -------
key_buffer_size = 16M
aria_pagecache_buffer_size = 16M

# --- Conexões e caches de sessão --------------------------------------------
max_connections = 50
thread_cache_size = 8
table_open_cache = 256
table_definition_cache = 400
max_allowed_packet = 32M
wait_timeout = 300
interactive_timeout = 300

# --- Buffers por consulta (valem por conexão; manter pequenos) --------------
sort_buffer_size = 512K
join_buffer_size = 512K
read_buffer_size = 256K
read_rnd_buffer_size = 256K
tmp_table_size = 16M
max_heap_table_size = 16M

# --- Economia de memória e de disco -----------------------------------------
# performance_schema instrumenta tudo e custa ~100 MB: desligado.
performance_schema = OFF
# Sem replicação: binlog só gastaria disco e page cache.
skip-log-bin
# Sem DNS reverso nas conexões (as grants usam host '%').
skip-name-resolve
local_infile = 0

# --- Padrões do projeto (Laravel usa utf8mb4_unicode_ci) --------------------
character_set_server = utf8mb4
collation_server = utf8mb4_unicode_ci
