# =============================================================================
# Infraestrutura compartilhada — copie para deploy/.env
# =============================================================================
# Este arquivo é lido APENAS pelo deploy/docker-compose.infra.yml.
#   cp deploy/.env.example deploy/.env
#   nano deploy/.env
#
# Regras para as senhas:
#   - gere com `openssl rand -base64 24`;
#   - sem aspas simples, aspas duplas ou `$` (o script de init monta SQL);
#   - senhas diferentes para cada banco; o root nunca vai para a aplicação.
# =============================================================================

TZ=America/Sao_Paulo

# --- Root do MariaDB (somente administração/backup) --------------------------
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# --- Instância astros21 ------------------------------------------------------
ASTROS21_DB_NAME=astros21_db
ASTROS21_DB_USER=astros21
ASTROS21_DB_PASSWORD=troque-esta-senha-astros21

# --- Instância voz-arcana ----------------------------------------------------
VOZ_ARCANA_DB_NAME=voz_arcana_db
VOZ_ARCANA_DB_USER=voz_arcana
VOZ_ARCANA_DB_PASSWORD=troque-esta-senha-voz-arcana
